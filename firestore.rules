rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email == 'nadeemalam178@gmail.com';
    }

    function isOwnerOrSelf(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isOwner());
    }

    // Products: Open read for all customers & guests; writes restricted exclusively to Store Owner
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Customer Profiles: Private to the authenticated user and Store Owner.
    // Customers can never elevate their own role to 'owner'.
    match /users/{userId} {
      allow read: if isOwnerOrSelf(userId);

      allow create: if isAuthenticated() &&
        (request.auth.uid == userId || isOwner()) &&
        (request.resource.data.role == 'customer' || isOwner());

      allow update: if isOwnerOrSelf(userId) &&
        (isOwner() || !('role' in request.resource.data) || request.resource.data.role == resource.data.role);

      allow delete: if isOwnerOrSelf(userId);
    }

    // Admin Session tracking & heartbeat: Read by authenticated users; write restricted to Store Owner
    match /admin_sessions/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // WhatsApp Order Logs: Customers can record their order logs; Store Owner has full access to read & analyze
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read, write: if isOwner();
    }

    // Broadcast Notifications: Open read for all customers & guests; writes restricted exclusively to Store Owner
    match /broadcast_notifications/{notificationId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

