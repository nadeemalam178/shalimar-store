rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'nadeemalam178@gmail.com' ||
        request.auth.token.email_verified == true
      );
    }

    // Products: Open read & write so admin additions mirror in real-time to customer phones
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer Profiles: Read public, write authenticated
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Admin Session tracking & heartbeat
    match /admin_sessions/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
