rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.email == 'nadeemalam178@gmail.com';
    }

    function isUserSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products: Anyone can read (customers browse anonymously), only owner can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /users/{userId} {
      allow read: if isUserSelf(userId) || isOwner();
      allow create: if isUserSelf(userId) && request.resource.data.role == 'customer';
      allow update: if isUserSelf(userId) && request.resource.data.role == resource.data.role;
      allow delete: if isOwner();
    }

    match /admin_sessions/active {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}